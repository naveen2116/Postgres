	provider "docker" {}
	
	provider "kubernetes" {
	  config_path = "~/.kube/config"
	}
	
	provider "postgresql" {
	  host     = "localhost"
	  port     = var.postgres_port
	  username = "postgres"
	  password = var.postgres_password
	  sslmode  = "disable"
	}
	
	resource "terraform_data" "k3d_cluster" {
	  input = {
	    name  = var.k3d_cluster_name
	    image = "rancher/k3s:${var.k3s_version}"
	  }
	
	  provisioner "local-exec" {
	    command = <<EOT
	k3d cluster create ${self.input.name} \
	  --image ${self.input.image} \
	  --servers 1 \
	  --agents 0 \
	  -p '8080:80@loadbalancer' \
	  --wait
	k3d kubeconfig merge ${self.input.name} --kubeconfig-merge-default
	EOT
	  }
	
	  provisioner "local-exec" {
	    when    = destroy
	    command = "k3d cluster delete ${self.input.name}"
	  }
	}
	
	resource "docker_image" "postgres" {
	  name         = "postgres:16-alpine"
	  keep_locally = true
	}
	
	resource "docker_volume" "postgres_data" {
	  name = "postgres-infra-takehome-data"
	}
	
	resource "docker_container" "postgres" {
	  name  = "postgres-infra-takehome"
	  image = docker_image.postgres.image_id
